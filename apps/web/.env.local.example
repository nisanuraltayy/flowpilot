# FlowPilot Web — environment ŞABLONU
#
# ============================================================================
# BU DOSYA BİR ŞABLONDUR. GERÇEK DEĞER İÇERMEZ.
# Gerçek değerler `.env.local` dosyasına yazılır; `.env.local` GIT'E COMMIT
# EDİLMEZ (.gitignore'daki `.env*` kuralı ile dışlanır).
#
# SERVICE ROLE KEY ve JWT SECRET BURADA ASLA YER ALMAZ — frontend yalnız
# public/publishable key kullanır (ADR-005).
# ============================================================================

# --- Supabase (public — browser'a gider) -----------------------------------
# Supabase proje URL'i. Boşsa: uygulama build olur ve render edilir; auth
# işlemleri kontrollü "Supabase yapılandırılmamış" mesajı üretir.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon/public) key — tarayıcıya gidebilen TEK anahtar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- FlowPilot API (SERVER-ONLY — browser bundle'a GİRMEZ) ------------------
# NEXT_PUBLIC_ öneki bilinçli olarak YOKTUR: FastAPI'ye Bearer istekleri yalnız
# Next.js server tarafından yapılır.
FLOWPILOT_API_BASE_URL=http://127.0.0.1:8000

# --- Uygulama ---------------------------------------------------------------
# Auth callback URL'inin türetildiği public adres.
NEXT_PUBLIC_APP_URL=http://localhost:3000
