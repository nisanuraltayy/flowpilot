# FlowPilot — environment değişkeni ŞABLONU
#
# ============================================================================
# BU DOSYA BİR ŞABLONDUR. GERÇEK DEĞER İÇERMEZ VE İÇERMEMELİDİR.
#
#   - Buraya ASLA gerçek secret, token, parola veya credential yazılmaz.
#   - Secret değerleri BOŞ bırakılmıştır. Uydurma değer üretilmez.
#   - Gerçek değerler `.env` dosyasına yazılır; `.env` GIT'E COMMIT EDİLMEZ
#     (.gitignore tarafından engellenir).
#
# Bkz. .claude/rules/security.md §7
# ============================================================================
#
# DURUM: Aşağıdaki değişkenlerin HİÇBİRİ henüz kullanılmıyor. Repository'de
# uygulama kodu yoktur. Bu dosya, ileride hangi KATEGORİLERDE değişken
# gerekeceğini gösteren bir haritadır. Değişken adları scaffold aşamasında
# kesinleşecektir.


# ---------------------------------------------------------------------------
# 1. UYGULAMA  — flowpilot.config.settings.Settings ile birebir eşleşir
#                (bu bölümdeki alanlar KODDA GERÇEKTEN KULLANILIYOR)
# ---------------------------------------------------------------------------
APP_NAME=FlowPilot

# local | test | development | staging | production
APP_ENVIRONMENT=local

APP_DEBUG=false

# debug | info | warning | error | critical
LOG_LEVEL=info

# API'nin dinleyeceği adres ve port
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------------
# 1b. HENÜZ KULLANILMAYAN uygulama alanları (frontend/tenant story'lerinde gelecek)
# ---------------------------------------------------------------------------
# Next.js web uygulamasının portu
WEB_PORT=3000

# Frontend'in API'ye ulaşacağı taban URL
API_BASE_URL=http://localhost:8000

# Varsayılan tenant ayarları (yalnız yeni organizasyon oluşturulurken varsayılan)
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_CURRENCY=TRY


# ---------------------------------------------------------------------------
# 2. LOCAL INFRASTRUCTURE — PostgreSQL  (infra/containers/compose.yaml)
#
# ⚠️ AŞAĞIDAKİ DEĞERLER YALNIZCA LOCAL DEVELOPMENT ÖRNEĞİDİR.
#    PRODUCTION CREDENTIAL DEĞİLDİR ve öyle kullanılmamalıdır.
#    Gerçek değerler `.env` dosyasına yazılır; `.env` GIT'E COMMIT EDİLMEZ.
#    Compose, bu değişkenler tanımlı değilse ANLAŞILIR HATA verip başlamaz.
#
# ADR-006 (tenant isolation + RLS), ADR-007 (transactional outbox)
# ---------------------------------------------------------------------------
POSTGRES_DB=flowpilot

# Bu, container'ın oluşturduğu BOOTSTRAP SUPERUSER'dır (bir ADMIN rolüdür).
# UYGULAMA BU ROLLE BAĞLANMAZ. PostgreSQL resmi imajı POSTGRES_USER'ı her zaman
# superuser yapar ve superuser RLS'i bypass eder. ADR-006 gereği uygulamanın
# bağlanacağı BYPASSRLS'siz "flowpilot_app" rolü Alembic/database foundation
# aşamasında ayrıca oluşturulacaktır.
POSTGRES_USER=flowpilot_admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Bootstrap superuser parolası — .env içinde ayarlanır. Burada BOŞ bırakılmıştır;
# sahte "güçlü görünümlü" bir production credential ÜRETİLMEZ.
POSTGRES_PASSWORD=

# --- Uygulama ve migration rolleri (scripts/provision_local_database.py oluşturur) ---
# Bunlar BYPASSRLS'siz, NOSUPERUSER rollerdir (ADR-006).
POSTGRES_APP_USER=flowpilot_app
POSTGRES_APP_PASSWORD=

POSTGRES_MIGRATION_USER=flowpilot_migrator
POSTGRES_MIGRATION_PASSWORD=

# --- Bağlantı dizeleri (psycopg sürücüsü) ---
# Uygulama bağlantısı: flowpilot_app (BYPASSRLS YOK, ADR-006). HTTP/app henüz yok.
# Örnek biçim (parolayı .env'de doldurun):
#   postgresql+psycopg://flowpilot_app:<parola>@localhost:5432/flowpilot
DATABASE_URL=

# Migration (Alembic) bağlantısı: flowpilot_migrator — app rolünden AYRIDIR.
#   postgresql+psycopg://flowpilot_migrator:<parola>@localhost:5432/flowpilot
MIGRATION_DATABASE_URL=


# ---------------------------------------------------------------------------
# 2b. LOCAL INFRASTRUCTURE — MinIO  (S3-compatible object storage)
#
# ⚠️ LOCAL DEVELOPMENT ÖRNEĞİ. Production credential DEĞİLDİR.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=flowpilot

# Local development parolası — .env içinde ayarlanır (MinIO en az 8 karakter ister).
MINIO_ROOT_PASSWORD=

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ---------------------------------------------------------------------------
# 3. SUPABASE AUTH  (ADR-005 — YALNIZCA JWT doğrulama)
# ---------------------------------------------------------------------------
# Supabase yalnız kimliği doğrular ve token üretir.
# Organization, membership, RBAC, authorization ve tenant modeli FlowPilot'ın
# KENDİ PostgreSQL veritabanındadır. Supabase'in org/rol modeli KULLANILMAZ.
# Supabase'in veritabanı FlowPilot'ın operasyonel veritabanı DEĞİLDİR.
#
# Doğrulama YALNIZ public JWKS iledir:
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# JWKS URL'i ve issuer SUPABASE_URL'den TÜRETİLİR — ayrıca yapılandırılmaz.
# SERVICE ROLE KEY ve JWT SECRET BİLİNÇLİ OLARAK YOKTUR ve KULLANILMAZ:
# public-key doğrulamada backend'de imzalama secret'ı bulunmaz (HS256 desteklenmez).

# Public proje URL'i (secret değildir). Boşsa: local/test'te health çalışmaya
# devam eder, auth gerektiren endpoint'ler 503 döner; staging/production'da
# uygulama BAŞLAMAZ.
SUPABASE_URL=

SUPABASE_JWT_AUDIENCE=authenticated

# Virgülle ayrılmış allow-list; YALNIZ asimetrik algoritmalar (HS* reddedilir).
SUPABASE_JWT_ALLOWED_ALGORITHMS=RS256,ES256

SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_JWKS_TIMEOUT_SECONDS=5

# Tarayıcıya gidebilecek TEK anahtar (public/anon) — frontend scaffold'unda
# kullanılacak; backend bunu KULLANMAZ.
SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# 4. OBJECT STORAGE  (FileStoragePort — S3-compatible; local: MinIO)
#
# HENÜZ KULLANILMIYOR — FileStoragePort adapter kodu yoktur. Local MinIO servisi
# infra/containers/compose.yaml ile ayağa kalkar; bağlantı bilgileri §2b'dedir.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=flowpilot-documents
STORAGE_FORCE_PATH_STYLE=true

# SECRET — local'de MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (§2b) ile eşleşir.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Presigned URL geçerlilik süresi (saniye) — kısa tutulur.
STORAGE_PRESIGNED_TTL_SECONDS=300

# Malware tarama adapter'ı: noop | <provider>
# MVP'de yalnız "noop". Gerçek tarama PILOT-READY zorunlu güvenlik kriteridir (ASM-0007).
MALWARE_SCAN_PROVIDER=noop


# ---------------------------------------------------------------------------
# 5. WORKER / OUTBOX  (ADR-007)
# ---------------------------------------------------------------------------
# Polling aralığı (ms). Bildirim enqueue hedefi < 5 s.
OUTBOX_POLL_INTERVAL_MS=1000

# Bir seferde alınacak event sayısı.
OUTBOX_BATCH_SIZE=50

# Bounded retry — SONSUZ RETRY YASAK.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=60

# --- Worker servis modu (python -m flowpilot.worker --serve) ---------------
# İşlenecek tenant'ların AÇIK allowlist'i (virgülle ayrılmış UUID listesi).
# Worker cross-tenant KEŞİF YAPMAZ: uygulama rolü `flowpilot_app` NOBYPASSRLS'tir
# ve güvenli global tenant registry YOKTUR; bu yüzden tenant'lar açıkça verilir.
# Her tenant kendi RLS context'inde, adil (round-robin) sırayla işlenir.
# CLI'da --tenant verilirse O geçerlidir (bu değişken kullanılmaz).
# Boş bırakılırsa --serve kontrollü hata verir (sessizce boş çalışmaz).
WORKER_TENANT_IDS=

# Worker service poll interval — sweep'ler arası bekleme (saniye).
# SECRET DEĞİLDİR. Minimum 0.1 saniye (busy-spin engellenir); 0, negatif, 0.1 altı,
# NaN ve infinity reddedilir ve worker kontrollü hata ile çıkar.
# CLI `--interval` DAHA ÖNCELİKLİDİR; bu değişken yalnız CLI verilmediğinde kullanılır.
# İkisi de yoksa güvenli default (1.0) uygulanır.
WORKER_POLL_INTERVAL_SECONDS=

# Worker process-level heartbeat dosyası (JSON yaşam döngüsü belgesi). SECRET
# DEĞİLDİR; içerik yalnız status/pid/UTC zaman damgaları/tenant SAYISI/hata sayacıdır
# (tenant UUID, DSN, token veya PII İÇERMEZ).
# Heartbeat KAPATILAMAZ: bu değişken TANIMSIZSA default yol kullanılır
# (/tmp/flowpilot-worker-heartbeat.json). Değişkeni tanımlayıp BOŞ bırakmak
# GEÇERSİZDİR ve worker/healthcheck kontrollü hata ile çıkar — bu yüzden burada
# yorum olarak bırakılmıştır; override etmek için açıp bir yol yazın.
# WORKER_HEARTBEAT_PATH=

# Heartbeat tazelik eşiği (saniye): `--check-heartbeat` yalnız status=healthy VE
# son TAM BAŞARILI sweep bu eşik içindeyse 0 döner. Boş bırakılırsa 60 kullanılır.
# Minimum 1.0; 0, negatif, 1 altı, NaN ve infinity reddedilir.
# Poll interval + en uzun sweep süresinden BÜYÜK seçilmelidir (yanlış alarm olmasın).
WORKER_HEARTBEAT_MAX_AGE_SECONDS=


# ---------------------------------------------------------------------------
# 6. GÖZLEMLENEBİLİRLİK
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=flowpilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Structured log formatı: json | console
LOG_FORMAT=json


# ---------------------------------------------------------------------------
# KAPSAM DIŞI — bu kategoriler MVP'de YOK, buraya değişken eklenmez:
#   - E-posta sağlayıcısı  → pilot-ready (ASM-0010)
#   - AI / LLM provider    → MVP dışı (LOCK-007 açık)
#   - Webhook / integration → MVP dışı
#   - Billing              → MVP dışı
# ---------------------------------------------------------------------------
