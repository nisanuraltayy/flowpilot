# FlowPilot — environment değişkeni ŞABLONU
#
# ============================================================================
# BU DOSYA BİR ŞABLONDUR. GERÇEK DEĞER İÇERMEZ VE İÇERMEMELİDİR.
#
#   - Buraya ASLA gerçek secret, token, parola veya credential yazılmaz.
#   - Secret değerleri BOŞ bırakılmıştır. Uydurma değer üretilmez.
#   - Gerçek değerler `.env` dosyasına yazılır; `.env` GIT'E COMMIT EDİLMEZ
#     (.gitignore tarafından engellenir).
#
# Bkz. .claude/rules/security.md §7
# ============================================================================
#
# DURUM: Aşağıdaki değişkenlerin HİÇBİRİ henüz kullanılmıyor. Repository'de
# uygulama kodu yoktur. Bu dosya, ileride hangi KATEGORİLERDE değişken
# gerekeceğini gösteren bir haritadır. Değişken adları scaffold aşamasında
# kesinleşecektir.


# ---------------------------------------------------------------------------
# 1. UYGULAMA
# ---------------------------------------------------------------------------
# Ortam adı: local | test | staging | production
APP_ENV=local

# Log seviyesi: debug | info | warning | error
LOG_LEVEL=info

# API'nin dinleyeceği port (preflight: 8000 boş)
API_PORT=8000

# Next.js web uygulamasının portu (preflight: 3000 boş)
WEB_PORT=3000

# Frontend'in API'ye ulaşacağı taban URL
API_BASE_URL=http://localhost:8000

# Varsayılan tenant ayarları (yalnız yeni organizasyon oluşturulurken varsayılan)
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_CURRENCY=TRY


# ---------------------------------------------------------------------------
# 2. POSTGRESQL  (ADR-006 tenant isolation + RLS, ADR-007 outbox)
# ---------------------------------------------------------------------------
# Local geliştirmede Docker container'da çalışır.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot_app

# SECRET — boş bırakıldı. Local değer .env içinde üretilir.
POSTGRES_PASSWORD=

# Uygulama bağlantı dizesi (yukarıdakilerden türetilebilir)
# ÖNEMLİ: Uygulamanın bağlandığı rol BYPASSRLS yetkisine SAHİP OLAMAZ (ADR-006).
DATABASE_URL=

# Migration (Alembic) için ayrı, DDL yetkili rol — uygulama rolünden AYRIDIR.
MIGRATION_DATABASE_URL=


# ---------------------------------------------------------------------------
# 3. SUPABASE AUTH  (ADR-005 — YALNIZCA authentication)
# ---------------------------------------------------------------------------
# Supabase yalnız kimliği doğrular ve token üretir.
# Organization, membership, RBAC, authorization ve tenant modeli FlowPilot'ın
# KENDİ PostgreSQL veritabanındadır. Supabase'in org/rol modeli KULLANILMAZ.
# Supabase'in veritabanı FlowPilot'ın operasyonel veritabanı DEĞİLDİR.

SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Tarayıcıya gidebilecek TEK anahtar (public/anon).
SUPABASE_ANON_KEY=

# SECRET — yalnız backend'de tutulur. Frontend'e ASLA gönderilmez, log'a yazılmaz.
SUPABASE_SERVICE_ROLE_KEY=

# Auth adapter seçimi: fake | supabase
# Testlerde ve local'de "fake" kullanılabilir; production'da "fake" YASAKTIR.
AUTH_PROVIDER=fake


# ---------------------------------------------------------------------------
# 4. OBJECT STORAGE  (FileStoragePort — S3-compatible; local: MinIO)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=flowpilot-documents
STORAGE_FORCE_PATH_STYLE=true

# SECRET — boş bırakıldı.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Presigned URL geçerlilik süresi (saniye) — kısa tutulur.
STORAGE_PRESIGNED_TTL_SECONDS=300

# Malware tarama adapter'ı: noop | <provider>
# MVP'de yalnız "noop". Gerçek tarama PILOT-READY zorunlu güvenlik kriteridir (ASM-0007).
MALWARE_SCAN_PROVIDER=noop


# ---------------------------------------------------------------------------
# 5. WORKER / OUTBOX  (ADR-007)
# ---------------------------------------------------------------------------
# Polling aralığı (ms). Bildirim enqueue hedefi < 5 s.
OUTBOX_POLL_INTERVAL_MS=1000

# Bir seferde alınacak event sayısı.
OUTBOX_BATCH_SIZE=50

# Bounded retry — SONSUZ RETRY YASAK.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=60


# ---------------------------------------------------------------------------
# 6. GÖZLEMLENEBİLİRLİK
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=flowpilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Structured log formatı: json | console
LOG_FORMAT=json


# ---------------------------------------------------------------------------
# KAPSAM DIŞI — bu kategoriler MVP'de YOK, buraya değişken eklenmez:
#   - E-posta sağlayıcısı  → pilot-ready (ASM-0010)
#   - AI / LLM provider    → MVP dışı (LOCK-007 açık)
#   - Webhook / integration → MVP dışı
#   - Billing              → MVP dışı
# ---------------------------------------------------------------------------
