# FlowPilot — editor davranışı
# https://editorconfig.org
#
# .gitattributes repository'deki satır sonlarını belirler; bu dosya editörün
# yazarken ne yapacağını belirler. İkisi birlikte tutarlı olmalıdır.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ------------------------------------------------------------------- Python
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

# --------------------------------------------------------------- TypeScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

# ------------------------------------------------------------------- config
[*.{json,jsonc}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.toml]
indent_size = 4

# ---------------------------------------------------------------- Markdown
# Markdown'da satır sonundaki iki boşluk anlamlıdır (satır kesme).
[*.md]
trim_trailing_whitespace = false

# ------------------------------------------------- Windows script'leri: CRLF
[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf

# ----------------------------------------------------------------- Makefile
[Makefile]
indent_style = tab
